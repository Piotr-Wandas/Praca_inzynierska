# Domyślnie przechowuj pliki tekstowe jako LF
* text=auto eol=lf

# Windows batch / PowerShell
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Kod i konfiguracja używane w Docker/Linux
*.py text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.env text eol=lf
.env.example text eol=lf

# Dokumentacja
*.md text eol=lf
*.txt text eol=lf